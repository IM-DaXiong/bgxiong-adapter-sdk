{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/control-operations.schema.json",
  "$defs": {
    "capabilitiesInput": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "runtimeCaps": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "pluginVersion": {
          "type": "string",
          "minLength": 1
        },
        "capabilityContracts": {
          "type": "array",
          "items": {
            "$ref": "https://bgxiong.local/vendor-adapter/v2/capability-contract.schema.json"
          }
        }
      },
      "required": [
        "schemaVersion",
        "pluginId",
        "pluginVersion",
        "capabilityContracts"
      ],
      "additionalProperties": false
    },
    "probeInput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "kind": {
              "enum": [
                "package_validation",
                "connectivity"
              ]
            },
            "configuration": {
              "type": "object"
            }
          },
          "required": [
            "schemaVersion",
            "kind",
            "configuration"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/operation-preflight.schema.json#/$defs/request"
        },
        {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/submission-resolution.schema.json#/$defs/request"
        },
        {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/operation-input.schema.json#/$defs/request"
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "kind": {
              "const": "operation_form_options"
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "capabilityKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "operationVersion": {
              "type": "integer",
              "minimum": 1
            },
            "inputSchemaDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "configuration": {
              "type": "object"
            }
          },
          "required": [
            "schemaVersion",
            "kind",
            "modelId",
            "capabilityKey",
            "operationId",
            "operationVersion",
            "inputSchemaDigest",
            "configuration"
          ],
          "additionalProperties": false
        }
      ]
    },
    "probeResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "packageValid": {
              "type": "boolean"
            },
            "connection": {
              "enum": [
                "not_checked",
                "ready",
                "failed"
              ]
            },
            "authentication": {
              "enum": [
                "not_checked",
                "ready",
                "failed"
              ]
            },
            "resources": {
              "enum": [
                "not_checked",
                "ready",
                "failed"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      "INVALID_PACKAGE",
                      "INVALID_CONFIGURATION",
                      "CONNECTION_FAILED",
                      "AUTHENTICATION_FAILED",
                      "RESOURCE_UNAVAILABLE"
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "packageValid",
            "connection",
            "authentication",
            "resources",
            "issues"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/operation-preflight.schema.json#/$defs/result"
        },
        {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/submission-resolution.schema.json#/$defs/result"
        },
        {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/operation-input.schema.json#/$defs/result"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "operation_form_options"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fieldPointer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "choices": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "maxItems": 2048,
                    "uniqueItems": true
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "fieldPointer",
                  "choices"
                ],
                "additionalProperties": false
              },
              "maxItems": 64,
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false
        }
      ]
    },
    "uploadInput": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityKey": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "operationVersion": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/media-input.schema.json"
        },
        "configuration": {
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "modelId",
        "capabilityKey",
        "operationId",
        "operationVersion",
        "role",
        "media",
        "configuration"
      ],
      "additionalProperties": false
    },
    "uploadResult": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1
        },
        "uploadRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mediaId",
        "uploadRef"
      ],
      "additionalProperties": false
    },
    "cancelResult": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "remote_requested",
            "remote_confirmed",
            "local_only",
            "unsupported"
          ]
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  }
}
