{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/operation-input.schema.json",
  "title": "OperationInputV1",
  "oneOf": [
    {
      "$ref": "#/$defs/draft"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pointer": {
      "type": "string",
      "pattern": "^(/([^~/]|~[01])*)+$"
    },
    "package": {
      "type": "object",
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "pluginId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/digest"
        },
        "package": {
          "$ref": "#/$defs/package"
        },
        "bindingId": {
          "type": "string",
          "minLength": 1
        },
        "bindingRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "configurationDigest": {
          "$ref": "#/$defs/digest"
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityKey": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "operationVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inputSchemaDigest": {
          "$ref": "#/$defs/digest"
        },
        "contractDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "capabilityId",
        "package",
        "bindingId",
        "bindingRevision",
        "configurationDigest",
        "modelId",
        "capabilityKey",
        "operationId",
        "operationVersion",
        "inputSchemaDigest",
        "contractDigest"
      ],
      "additionalProperties": false
    },
    "mediaBinding": {
      "type": "object",
      "properties": {
        "inputPointer": {
          "$ref": "#/$defs/pointer"
        },
        "mediaIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "inputPointer",
        "mediaIds"
      ],
      "additionalProperties": false
    },
    "draft": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "input": {
          "type": "object"
        },
        "mediaBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaBinding"
          }
        },
        "draftRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "selection",
        "input",
        "mediaBindings",
        "draftRevision"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "revisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "ready": {
          "type": "boolean"
        }
      },
      "required": [
        "revisionDigest",
        "ready"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "operation_input_preflight"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "configuration": {
          "type": "object"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "input": {
          "type": "object"
        },
        "mediaMetadata": {
          "type": "array",
          "items": {
            "$ref": "https://bgxiong.local/vendor-adapter/v2/operation-preflight.schema.json#/$defs/mediaMetadata"
          }
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "selection",
        "configuration",
        "environment",
        "input",
        "mediaMetadata",
        "requestDigest"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "fieldPointer": {
          "type": "string",
          "pattern": "^(/([^~/]|~[01])*)*$"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "operation_input_preflight"
            },
            "status": {
              "const": "ready"
            },
            "requestDigest": {
              "$ref": "#/$defs/digest"
            },
            "material": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "status",
            "requestDigest",
            "material"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "operation_input_preflight"
            },
            "status": {
              "const": "rejected"
            },
            "requestDigest": {
              "$ref": "#/$defs/digest"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              },
              "minItems": 1,
              "maxItems": 64
            }
          },
          "required": [
            "kind",
            "status",
            "requestDigest",
            "diagnostics"
          ],
          "additionalProperties": false
        }
      ]
    },
    "preparation": {
      "type": "object",
      "properties": {
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "materialDigest": {
          "$ref": "#/$defs/digest"
        },
        "material": {
          "type": "object"
        },
        "environmentRevisionDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "requestDigest",
        "materialDigest",
        "material",
        "environmentRevisionDigest"
      ],
      "additionalProperties": false
    },
    "errorContext": {
      "type": "object",
      "properties": {
        "layer": {
          "enum": [
            "host",
            "sdk",
            "adapter",
            "upstream"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnostic"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        },
        "submissionState": {
          "enum": [
            "not_submitted",
            "rejected",
            "acceptance_unknown",
            "accepted",
            "terminal"
          ]
        }
      },
      "required": [
        "layer",
        "stage",
        "diagnostic",
        "submissionState"
      ],
      "additionalProperties": false
    }
  }
}
