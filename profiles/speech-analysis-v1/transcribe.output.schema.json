{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/speech-analysis-v1/transcribe.output.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "speechState": {
      "enum": [
        "speech",
        "no_speech"
      ]
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 35,
      "pattern": "^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$"
    }
  },
  "required": [
    "schemaVersion",
    "text",
    "speechState",
    "durationMs"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "speechState": {
          "const": "speech"
        },
        "text": {
          "pattern": "\\S"
        }
      }
    },
    {
      "properties": {
        "speechState": {
          "const": "no_speech"
        },
        "text": {
          "const": ""
        }
      }
    }
  ]
}
