{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/speech-analysis-v1/diarize.output.schema.json",
  "anyOf": [{"type": "null"}, {"$ref": "#/$defs/Result"}],
  "$defs": {
    "Result": {
      "type": "object",
      "properties": {
        "schemaVersion": {"const": 1},
        "sourceFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "durationMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "speakers": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}}, "required": ["id"], "additionalProperties": false}},
        "turns": {"type": "array", "items": {"$ref": "#/$defs/Turn"}},
        "overlapDetection": {"enum": ["unsupported", "available"]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["schemaVersion", "sourceFingerprint", "durationMs", "speakers", "turns", "overlapDetection", "warnings"],
      "additionalProperties": false
    },
    "Turn": {
      "type": "object",
      "properties": {
        "startMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "endMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "speakerId": {"type": "string", "minLength": 1}
      },
      "required": ["startMs", "endMs", "speakerId"],
      "additionalProperties": false
    }
  }
}
