{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/speech-analysis-v1/subtitle.output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "speechState",
    "sampleRate",
    "originalFrames",
    "cues"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "speechState": {
      "enum": [
        "speech",
        "no_speech"
      ]
    },
    "sampleRate": {
      "const": 16000
    },
    "originalFrames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 480000
    },
    "cues": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startSample",
          "endSample",
          "text"
        ],
        "properties": {
          "startSample": {
            "type": "integer",
            "minimum": 0,
            "maximum": 480000
          },
          "endSample": {
            "type": "integer",
            "minimum": 1,
            "maximum": 480000
          },
          "text": {
            "type": "string",
            "maxLength": 65536,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "speechState": {
          "const": "speech"
        },
        "cues": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "speechState": {
          "const": "no_speech"
        },
        "cues": {
          "maxItems": 0
        }
      }
    }
  ]
}
