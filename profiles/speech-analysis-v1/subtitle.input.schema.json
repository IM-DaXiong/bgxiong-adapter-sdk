{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/speech-analysis-v1/subtitle.input.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "audio": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mediaId"
      ],
      "additionalProperties": false
    },
    "timing": {
      "const": "segmentTimed"
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35,
      "pattern": "^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$"
    }
  },
  "required": [
    "schemaVersion",
    "audio",
    "timing"
  ],
  "additionalProperties": false
}
