{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/speech-analysis-v1/diarize.input.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": 1},
    "audio": {"type": "object", "properties": {"mediaId": {"type": "string", "minLength": 1}}, "required": ["mediaId"], "additionalProperties": false},
    "sourceFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "durationMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "speakerCount": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  },
  "required": ["schemaVersion", "audio", "sourceFingerprint", "durationMs"],
  "additionalProperties": false
}
